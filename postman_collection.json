            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 34,\n  \"gender\": \"male\",\n  \"phone\": \"+1-555-0100\",\n  \"address\": \"12 Main St, Springfield\",\n  \"blood_group\": \"O+\",\n  \"allergies\": \"Penicillin\",\n  \"medical_history\": \"Hypertension\"\n}"
